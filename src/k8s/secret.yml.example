# Copy to secret.yml (do not commit) and apply: kubectl apply -f secret.yml
# Or create via: kubectl create secret generic paycomputation-secrets \
#   --from-literal=mongodb-uri='mongodb+srv://USER:PASS@HOST/DB?...'
apiVersion: v1
kind: Secret
metadata:
  name: paycomputation-secrets
type: Opaque
stringData:
  mongodb-uri: "mongodb+srv://USER:PASSWORD@HOST/DATABASE?tls=true&authSource=admin&replicaSet=REPLICA"
